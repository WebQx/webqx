# Sanitized env for dry preflight
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://webqx.health,https://portal.webqx.health
API_RATE_LIMIT_MAX=1000
API_RATE_LIMIT_WINDOW_MS=900000
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TIMEOUT=5000

OAUTH2_ISSUER=https://auth.example.com
OAUTH2_CLIENT_ID=webqx-client
OAUTH2_CLIENT_SECRET=placeholder
OAUTH2_JWKS_URI=https://auth.example.com/.well-known/jwks.json

USE_REMOTE_OPENEMR=true
OPENEMR_REMOTE_URL=https://emr.example.com
OPENEMR_CLIENT_ID=webqx-api-gateway
OPENEMR_CLIENT_SECRET=placeholder

FHIR_BASE_URL=https://emr.example.com/apis/default/fhir
PUBLIC_FHIR_BASE=https://api.example.com/fhir
FHIR_VALIDATE_RESOURCES=true

HIPAA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HIPAA_AUDIT_ENABLED=true
HIPAA_COMPLIANT_MODE=true
HIPAA_RETENTION_DAYS=2555
AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_LOG_PATH=./logs/hipaa-audit.log
PHI_DETECTION_ENABLED=true
PHI_ANONYMIZATION_ENABLED=true
SESSION_TIMEOUT_MINUTES=60
MAX_CONCURRENT_SESSIONS=10
REQUIRE_PATIENT_CONSENT=true

RABBITMQ_URL=amqps://user:pass@rabbit.example.com:5671/vhost
RABBITMQ_HEARTBEAT=60
RABBITMQ_CONNECTION_TIMEOUT=10000

STRUCTURED_LOGGING=true
METRICS_ENABLED=true
